{
  "expo": {
    "name": "Ekklesphere Attendance",
    "slug": "ekklesphere-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6D5CF2"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to record check-in and check-out at your designated site.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We use background location only to verify entrance and exit at your designated site."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6D5CF2"
      },
      "package": "com.akoko.ekklesphere.attendance",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "We use your location only to record check-in and check-out at your work site.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
