{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document containing authentication metadata and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "usher", "member"] },
        "title": { "type": "string" },
        "campusName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Person": {
      "title": "Person",
      "description": "Registered church congregation member or attendee in the directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "preferredName": { "type": "string" },
        "phoneE164": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["member", "visitor", "inactive", "transferred", "deceased"] },
        "groupName": { "type": "string" },
        "householdRole": { "type": "string", "enum": ["head", "spouse", "child", "other"] },
        "autoCheckinOptedIn": { "type": "boolean" },
        "avatarInitials": { "type": "string" },
        "joinedOn": { "type": "string" },
        "consecutiveAbsences": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "phoneE164", "status", "groupName", "autoCheckinOptedIn"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Church service attendance check-in record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "personId": { "type": "string" },
        "serviceInstanceId": { "type": "string" },
        "campusId": { "type": "string" },
        "method": { "type": "string" },
        "confidence": { "type": "number" },
        "checkedInAt": { "type": "string" },
        "late": { "type": "boolean" }
      },
      "required": ["id", "personId", "serviceInstanceId", "method", "checkedInAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Campus proximity parameters, geofencing radii, and automated care rules",
      "type": "object",
      "properties": {
        "churchName": { "type": "string" },
        "campusName": { "type": "string" },
        "campusAddress": { "type": "string" },
        "campusLatitude": { "type": "number" },
        "campusLongitude": { "type": "number" },
        "campusLocationAccuracyM": { "type": "number" },
        "campusLocationUpdatedAt": { "type": "string" },
        "seniorPastor": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "timezone": { "type": "string" },
        "currency": { "type": "string" },
        "outerGeofenceMeters": { "type": "number" },
        "innerGeofenceMeters": { "type": "number" },
        "dwellTimeMinutes": { "type": "number" },
        "serviceWindowBeforeMinutes": { "type": "number" },
        "serviceWindowAfterMinutes": { "type": "number" },
        "bleBeaconRssiThreshold": { "type": "number" },
        "driveByProtection": { "type": "boolean" },
        "absenteeThresholdServices": { "type": "number" },
        "firstTimerFollowupHours": { "type": "number" },
        "autoAssignCellLeaders": { "type": "boolean" },
        "requireExplicitConsent": { "type": "boolean" },
        "auditLogRetentionDays": { "type": "number" },
        "smsGatewayProvider": { "type": "string" },
        "smsSenderId": { "type": "string" },
        "enablePushNotifications": { "type": "boolean" }
      },
      "required": ["churchName", "campusName", "outerGeofenceMeters", "innerGeofenceMeters", "dwellTimeMinutes"]
    },
    "ChurchGroup": {
      "title": "ChurchGroup",
      "description": "Church ministry department, demographic fellowship, or neighborhood cell group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["ministry", "fellowship", "cell_group"] },
        "leaderName": { "type": "string" },
        "leaderPhone": { "type": "string" },
        "leaderEmail": { "type": "string" },
        "assistantLeader": { "type": "string" },
        "meetingDay": { "type": "string" },
        "meetingTime": { "type": "string" },
        "meetingLocation": { "type": "string" },
        "targetDemographic": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "leaderName", "active"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Church offering, tithing, or ministry contribution record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "personId": { "type": "string" },
        "fundName": { "type": "string" },
        "amountMinor": { "type": "number" },
        "currency": { "type": "string" },
        "method": { "type": "string", "enum": ["momo", "card", "cash", "bank"] },
        "provider": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "paidAt": { "type": "string" }
      },
      "required": ["id", "fundName", "amountMinor", "currency", "method", "provider", "status", "paidAt"]
    },
    "License": {
      "title": "License",
      "description": "Platform subscription license for a church congregation tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "tier": { "type": "string", "enum": ["grace_starter", "ministry_pro", "cathedral_enterprise"] },
        "tenantId": { "type": "string" },
        "seatsLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired", "revoked", "grace_period"] },
        "issuedDate": { "type": "string" },
        "expiresDate": { "type": "string" },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual", "lifetime"] },
        "annualCostUSD": { "type": "number" }
      },
      "required": ["id", "key", "tier", "seatsLimit", "status", "issuedDate"]
    },
    "ServiceEvent": {
      "title": "ServiceEvent",
      "description": "Church worship service instance, revival, or special program event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "campusId": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string" },
        "startsAt": { "type": "string" },
        "endsAt": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "scheduled", "draft"] },
        "expectedAttendance": { "type": "number" },
        "dwellMinutes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "startsAt"]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "ServiceEvent",
      "description": "Church worship service instances and scheduled programs"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered and authenticated users"
    },
    "/members/{memberId}": {
      "schema": "Person",
      "description": "Registered church congregation members and visitor roster"
    },
    "/attendance_records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance check-ins for church services"
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Campus proximity parameters and automated thresholds"
    },
    "/church_groups/{groupId}": {
      "schema": "ChurchGroup",
      "description": "Ministries, demographic fellowships, and neighborhood home cell small groups"
    },
    "/donations/{donationId}": {
      "schema": "Donation",
      "description": "Church financial donations, offerings, and tithing"
    },
    "/licenses/{licenseId}": {
      "schema": "License",
      "description": "Platform tenant software licenses"
    }
  }
}
