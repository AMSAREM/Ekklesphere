# Public Browser Client Variables (Safe for Vite bundle - ANON KEY ONLY)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_CHURCH_SLUG=accra-central

# Server-Only Secrets (NEVER prefix with VITE_ or expose to browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
CRON_SECRET=

# Platform Creator Bootstrap & Secrets (Server-Only — NEVER prefix with VITE_)
# Provide these in environment secrets OR insert hashed credentials into public.account_credentials via `npm run seed:creator`
CREATOR_EMAIL=
CREATOR_PASSWORD=
CREATOR_USERNAME=
CREATOR_PHONE=
CREATOR_NAME=
CREATOR_ORGANIZATION_ID=
# Optional one-time secret authorizing POST /api/auth/bootstrap-creator to write a Creator record into Supabase DB
CREATOR_BOOTSTRAP_SECRET=

# Generic temporary onboarding password auto-assigned to newly onboarded members (Server-Only; min 8 chars, defaults to Ekklesphere@2026)
MEMBER_DEFAULT_ONBOARDING_PASSWORD=

# Mobile Geofence Client (Expo / Android)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# Optional AI / Platform Integrations
GEMINI_API_KEY=