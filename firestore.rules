rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'amoakoemmanuel2020@gmail.com' ||
        request.auth.token.email == 'elenamends@gmail.com' ||
        request.auth.token.email == 'pastor.david@ekklesphere.org' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 2. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().id == userId &&
        incoming().email is string &&
        incoming().name is string;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email;
      allow delete: if isAdmin();
    }

    // 3. Members Collection (Congregation Roster)
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        (incoming().firstName is string && incoming().lastName is string && incoming().phoneE164 is string)
      );
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    // 4. Attendance Records
    match /attendance_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        incoming().personId is string
      );
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    // 5. System Settings
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    // 6. Test connection probe
    match /test/{docId} {
      allow read: if true;
    }
  }
}
