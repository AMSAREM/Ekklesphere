rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PHASE 0 SECURITY REMEDIATION:
    // 1. All hardcoded personal email super-admin grants have been permanently purged.
    // 2. Ekklesphere web & mobile authentication and persistence now run exclusively on
    //    Supabase Auth + Supabase Postgres with Row Level Security (app_metadata.creator
    //    and has_organization_access).
    // 3. Legacy client-side Firestore reads and writes are locked down (default-deny).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
