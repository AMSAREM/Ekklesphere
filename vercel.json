{
  "version": 2,
  "crons": [
    {
      "path": "/api/console/cron/rollup",
      "schedule": "15 0 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "api/_server.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
